% -------------------- 页面与字体 --------------------
\geometry{
  paperwidth=182mm,
  paperheight=257mm,
  left=18mm,
  right=18mm,
  top=20mm,
  bottom=20mm   % 稍微小一点，给页码留空间
}
\setstretch{1.1}
\setlength{\parindent}{2em}
\setlength{\parskip}{0.35em}

\setCJKmainfont{Noto Serif CJK SC}[
  UprightFont = * Light,          % 默认用细的
  BoldFont    = * Bold,           % 加粗时用 Bold
  % 如果觉得 Light 太细，可以改成 * Regular 或 * Medium
]

\setCJKsansfont{Noto Sans CJK SC}[
  UprightFont = * Regular,
  BoldFont    = * Bold
]
